{
  "phase": "4.5",
  "specification_name": "Deterministic Tri-Model Unified Threat Inference Specification",
  "version": "2.9.0",
  "architecture": {
    "model_count": 3,
    "models": {
      "autoencoder": {
        "role": "Current-window unsupervised anomaly detection",
        "input": "13 features scaled via autoencoder_scaler.joblib",
        "threshold": 0.003207791231673312,
        "decision_comparator": "MSE(t) >= 0.003207791231673312"
      },
      "xgboost": {
        "role": "Current-window 8-class attack categorization",
        "input": "13 unscaled raw features",
        "classes": [
          "BENIGN",
          "Brute Force",
          "Bot",
          "DoS",
          "Infiltration",
          "PortScan",
          "Web Attack",
          "DDoS"
        ],
        "decision_rule": "binary: argmax(probs, axis=1) != 0"
      },
      "lstm": {
        "role": "Forward-looking attack forecasting targeting subsequent window t",
        "input": "Lookback sequence [t-10 .. t-1] scaled via lstm_scaler.joblib",
        "threshold": 0.3,
        "decision_comparator": "P(attack) >= 0.3",
        "boundary_policy": "strict_day_boundary_isolation"
      }
    },
    "temporal_alignment": "AE(t) + XGB(t) + LSTM(t-1 -> t)"
  },
