{
    "phase": "3.3",
    "feature_configuration": {
        "feature_count": 13,
        "feature_dtype": "float32",
        "feature_columns": [
            "flow_count",
            "packet_rate",
            "byte_rate",
            "mean_flow_duration",
            "std_flow_duration",
            "short_flow_ratio",
            "mean_packet_size",
            "packet_length_variability",
            "fwd_bwd_packet_ratio",
            "unique_dst_ports",
            "unique_dst_ips",
            "tcp_flow_ratio",
            "syn_packet_ratio"
